<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Nouvelle commande — BEM Admin</title>
</head>
<body style="margin:0;padding:0;background:#f4f2ef;font-family:'Helvetica Neue',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f2ef;padding:32px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.08);max-width:600px;width:100%;">

          <!-- Header -->
          <tr>
            <td style="background:#cc1f27;padding:24px 36px;text-align:center;">
              <p style="margin:0;color:#ffffff;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;font-weight:600;">BEM Shop — Administration</p>
              <p style="margin:8px 0 0;color:#ffffff;font-size:20px;font-weight:800;">Nouvelle commande reçue</p>
            </td>
          </tr>

          <!-- Alert badge -->
          <tr>
            <td style="padding:28px 36px 20px;border-bottom:1px solid #f0ede8;">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <p style="margin:0 0 4px;font-size:12px;color:#9ca3af;text-transform:uppercase;letter-spacing:0.08em;">Référence commande</p>
                    <p style="margin:0;font-family:monospace;font-size:20px;font-weight:800;color:#0d0d0d;">#{{orderId}}</p>
                  </td>
                  <td style="text-align:right;vertical-align:top;">
                    <span style="display:inline-block;padding:6px 14px;background:#fef2f2;border:1px solid #fecaca;border-radius:20px;font-size:12px;font-weight:700;color:#cc1f27;">
                      Action requise
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Client info -->
          <tr>
            <td style="padding:20px 36px 0;">
              <p style="margin:0 0 12px;font-size:13px;font-weight:800;color:#0d0d0d;text-transform:uppercase;letter-spacing:0.08em;">Client</p>
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#f7f6f4;border-radius:8px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <table cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding:3px 0;font-size:13px;color:#6b7280;width:100px;">Nom</td>
                        <td style="padding:3px 0;font-size:13px;font-weight:600;color:#0d0d0d;">{{clientFirstName}} {{clientLastName}}</td>
                      </tr>
                      <tr>
                        <td style="padding:3px 0;font-size:13px;color:#6b7280;">Email</td>
                        <td style="padding:3px 0;font-size:13px;font-weight:600;color:#0d0d0d;">{{clientEmail}}</td>
                      </tr>
                      <tr>
                        <td style="padding:3px 0;font-size:13px;color:#6b7280;">Mode</td>
                        <td style="padding:3px 0;font-size:13px;font-weight:600;color:#0d0d0d;">{{deliveryLabel}}</td>
                      </tr>
                      {{#if address}}
                      <tr>
                        <td style="padding:3px 0;font-size:13px;color:#6b7280;">Adresse</td>
                        <td style="padding:3px 0;font-size:13px;font-weight:600;color:#0d0d0d;">{{address}}</td>
                      </tr>
                      {{/if}}
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Products -->
          <tr>
            <td style="padding:24px 36px 0;">
              <p style="margin:0 0 14px;font-size:13px;font-weight:800;color:#0d0d0d;text-transform:uppercase;letter-spacing:0.08em;">Articles commandés</p>

              {{#each items}}
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:10px;border:1px solid #f0ede8;border-radius:8px;overflow:hidden;">
                <tr>
                  {{#if this.imageUrl}}
                  <td width="72" style="padding:10px;vertical-align:middle;">
                    <img src="{{this.imageUrl}}" alt="{{this.productName}}"
                      width="60" height="60"
                      style="border-radius:6px;object-fit:cover;display:block;background:#f7f6f4;" />
                  </td>
                  {{else}}
                  <td width="72" style="padding:10px;vertical-align:middle;">
                    <div style="width:60px;height:60px;background:#f7f6f4;border-radius:6px;"></div>
                  </td>
                  {{/if}}
                  <td style="padding:10px 10px 10px 0;vertical-align:middle;">
                    <p style="margin:0 0 3px;font-size:13px;font-weight:700;color:#0d0d0d;">{{this.productName}}</p>
                    <p style="margin:0;font-size:12px;color:#9ca3af;">Qté : {{this.quantity}}</p>
                  </td>
                  <td style="padding:10px;vertical-align:middle;text-align:right;white-space:nowrap;">
                    <p style="margin:0;font-size:13px;font-weight:800;color:#0d0d0d;">{{this.unitPrice}} FCFA</p>
                    <p style="margin:3px 0 0;font-size:11px;color:#9ca3af;">/ unité</p>
                  </td>
                </tr>
              </table>
              {{/each}}

              <!-- Total -->
              <table width="100%" cellpadding="0" cellspacing="0" style="border-top:2px solid #0d0d0d;margin-top:6px;">
                <tr>
                  <td style="padding-top:14px;font-size:14px;font-weight:700;color:#0d0d0d;">Total commande</td>
                  <td style="padding-top:14px;font-size:20px;font-weight:900;color:#cc1f27;text-align:right;">{{totalAmountFormatted}} FCFA</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Pickup reminder -->
          <tr>
            <td style="padding:20px 36px 28px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#fef9f0;border:1px solid #fde68a;border-radius:8px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#0d0d0d;">📍 Récupération — Campus BEM</p>
                    <p style="margin:0;font-size:12px;color:#6b7280;line-height:1.6;">
                      Paiement à la récupération · Espèces / Orange Money / Wave / Free Money<br/>
                      Statut actuel : <strong style="color:#cc1f27;">En attente de confirmation</strong>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding:0 36px 32px;text-align:center;">
              <a href="{{frontendUrl}}/admin/orders"
                style="display:inline-block;padding:14px 32px;background:#cc1f27;color:#ffffff;font-size:13px;font-weight:700;text-decoration:none;border-radius:8px;letter-spacing:0.06em;">
                Gérer la commande →
              </a>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#f7f6f4;padding:20px 36px;text-align:center;border-top:1px solid #e5e2dc;">
              <p style="margin:0;font-size:11px;color:#9ca3af;">
                © BEM Shop — Notification automatique d'administration. Ne pas répondre à cet email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
